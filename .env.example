# GROQ API key for LLM features (chat, quiz generation)
# Get at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# PostgreSQL (docker-compose defaults, override if needed)
POSTGRES_USER=kubeai
POSTGRES_PASSWORD=kubeai
POSTGRES_DB=kubeai

# Clerk
CLERK_SECRET_KEY=sk_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_your_clerk_publishable_key
